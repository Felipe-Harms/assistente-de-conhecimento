# =============================================================================
# Upwork Knowledge Assistant — environment template
# =============================================================================
# Copy to `.env` (which is gitignored) and adjust per-environment.
# Every value here is a PLACEHOLDER. No real secret is committed.
# =============================================================================

# ---- API service -----------------------------------------------------------
# Bind address for the FastAPI HTTP server.
API_HOST=0.0.0.0
API_PORT=8000
# Log level: DEBUG | INFO | WARNING | ERROR.
API_LOG_LEVEL=INFO

# ---- Database (PostgreSQL + pgvector) -------------------------------------
# Credentials are dev-only defaults. Override per environment.
POSTGRES_USER=upworkkb
POSTGRES_PASSWORD=change-me-locally-only
POSTGRES_DB=upworkkb
POSTGRES_HOST=db
POSTGRES_PORT=5432
# SQLAlchemy-style URL for the API.
DATABASE_URL=postgresql+asyncpg://upworkkb:change-me-locally-only@db:5432/upworkkb

# ---- Auth (REQ-007) --------------------------------------------------------
# Master switch. Default OFF so dev runs without ceremony.
AUTH_ENABLED=false
# Pre-shared token used when AUTH_ENABLED=true (Bearer scheme).
# Must be set via secret manager in non-dev environments — never commit a real value.
AUTH_TOKEN=replace-with-long-random-token

# ---- Embedding provider (DEC-005, OpenAI-compatible adapter) ---------------
# Adapter is configurable per env so we are not coupled to a vendor.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-replace-me-with-real-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# When `true`, adapter uses a deterministic local stub (no network calls).
EMBEDDING_STUB=true

# ---- Retention (REQ-007) ---------------------------------------------------
# Days to keep audit logs and chat history. 0 means forever (not recommended).
RETENTION_DAYS=90

# ---- UI identity (REQ-006) -------------------------------------------------
# Operator-configurable brand surface served at GET /v1/identity and consumed
# by the static UI at load time. Every value here is a PLACEHOLDER.
# APP_BRAND_NAME   → header <h1> + document title
# APP_TAGLINE      → subtitle under the brand
# APP_ACCENT_COLOR → CSS color literal (#rgb, #rrggbb, rgb(...)). Validated
#                    server-side; malformed values fall back to #0284c7.
# APP_LOGO_URL     → optional URL of a brand mark (empty disables)
# APP_FOOTER_NOTE  → free-text footer line
APP_BRAND_NAME=Upwork Knowledge Assistant
APP_TAGLINE=Local, grounded answers from a curated corpus — refuses when evidence is missing.
APP_ACCENT_COLOR=#0284c7
APP_LOGO_URL=
APP_FOOTER_NOTE=Local-only proof build. Citations are mandatory — read them.

# ---- UI / ports ------------------------------------------------------------
UI_PORT=8080
# API endpoint the UI talks to (used by nginx proxy).
UI_API_BASE=http://api:8000

# ---- Test service ----------------------------------------------------------
# Internal markers used by the test image to opt into slow/online markers.
PYTEST_ADDOPTS=-ra
